<% content_for :title, "メンバー一覧" %>

<%= component :page_layout, title: "メンバー一覧" do |page| %>
  <% page.with_breadcrumb "メンバー一覧" %>

  <% page.with_action do %>
    <% if policy([ :studios, Invitation.new(studio: @studio) ]).create? %>
      <%= link_to "メンバーを招待", new_studio_invitation_path(@studio.slug), class: "btn btn-primary" %>
    <% else %>
      <button type="button" class="btn btn-primary" disabled>メンバーを招待</button>
    <% end %>
  <% end %>

  <%= component :table_layout do %>
    <table id="memberships" class="table">
      <thead>
        <tr>
          <th>ユーザー名</th>
          <th>役割</th>
          <th>参加日時</th>
        </tr>
      </thead>

      <tbody>
        <% @studio_memberships.each do |studio_membership| %>
          <tr>
            <td><%= studio_membership.writer.account.username %></td>

            <td>
              <%= StudioMembership.human_attribute_name("role.#{studio_membership.role}") %>
            </td>

            <td><%= l studio_membership.created_at, format: :short %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
