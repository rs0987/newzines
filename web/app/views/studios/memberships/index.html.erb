<% content_for :title, "メンバー一覧" %>

<%= component :page_layout, title: "メンバー一覧" do |page| %>
  <% page.with_breadcrumb "メンバー一覧" %>

  <% page.with_action do %>
    <%= link_to "招待一覧", studio_invitations_path(@studio.slug), class: "btn" %>
  <% end %>

  <% page.with_action do %>
    <% if policy([ :studios, Invitation.new(studio: @studio) ]).create? %>
      <%= link_to "メンバーを招待", new_studio_invitation_path(@studio.slug), class: "btn btn-primary" %>
    <% else %>
      <button type="button" class="btn btn-primary" disabled>メンバーを招待</button>
    <% end %>
  <% end %>

  <%= component :table_layout do %>
    <table id="memberships" class="table">
      <thead>
        <tr>
          <th>ユーザー名</th>
          <th>役割</th>
          <th>参加日時</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @studio_memberships.each do |studio_membership| %>
          <tr>
            <td><%= studio_membership.writer.account.username %></td>

            <td>
              <%= StudioMembership.human_attribute_name("role.#{studio_membership.role}") %>
            </td>

            <td><%= l studio_membership.created_at, format: :short %></td>

            <td class="text-right">
              <% if policy([ :studios, studio_membership ]).update? %>
                <% dialog_id = dom_id(studio_membership, :role_dialog) %>

                <button
                  type="button"
                  class="btn btn-sm"
                  commandfor="<%= dialog_id %>"
                  command="show-modal"
                >
                  役割を変更
                </button>

                <%= component :dialog, id: dialog_id, title: "役割の変更" do %>
                  <%= turbo_frame_tag dom_id(studio_membership, :role_form),
                        src: edit_studio_membership_path(@studio.slug, studio_membership), loading: :lazy do %>
                    <span class="loading loading-spinner"></span>
                  <% end %>
                <% end %>
              <% else %>
                <button type="button" class="btn btn-sm" disabled>役割を変更</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
