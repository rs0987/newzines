<%= form_with model: zine, url: (zine.new_record? ? studio_zines_path(studio.slug) : studio_zine_path(studio.slug, zine)) do |f| %>
  <%= component :form_layout do |layout| %>
    <%= component :text_field, f, :title, label: "タイトル", hint: "30 文字まで。",
          required: true, maxlength: 30, autofocus: true %>

    <%= component :text_area_field, f, :description, label: "紹介文", hint: "200 文字まで。",
          maxlength: 200, rows: 4 %>

    <%= component :select_field, f, :editor_id,
          studio.writers.includes(:account).map { |writer| [ writer.account.username, writer.id ] }.sort,
          label: "責任編集者", hint: "スタジオのメンバーから選びます。",
          required: true %>

    <% layout.with_action do %>
      <%= f.submit "保存", class: "btn btn-primary btn-wide" %>
    <% end %>
  <% end %>
<% end %>
