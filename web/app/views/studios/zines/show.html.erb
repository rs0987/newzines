<% content_for :title, @zine.title %>

<%= component :page_layout, title: @zine.title do |page| %>
  <% page.with_breadcrumb "ZINE 一覧", studio_zines_path(@studio.slug) %>
  <% page.with_breadcrumb @zine.title %>

  <% page.with_action do %>
    <%= link_to "編集", edit_studio_zine_path(@studio.slug, @zine), class: "btn" %>
  <% end %>

  <div class="flex flex-col gap-6">
    <%= component :card, title: "基本情報" do %>
      <%= component :description_list do |list| %>
        <% list.with_item "紹介文" do %>
          <p class="whitespace-pre-wrap"><%= @zine.description %></p>
        <% end %>

        <% list.with_item "責任編集者" do %>
          <%= @zine.editor.account.username %>
        <% end %>

        <% list.with_item Zine.human_attribute_name(:theme_color) do %>
          <%= component :zine_theme_color_sample, theme_color: @zine.theme_color %>
        <% end %>

        <% list.with_item "作成日時" do %>
          <%= l @zine.created_at, format: :short %>
        <% end %>
      <% end %>
    <% end %>

    <%= component :card, title: "ページ" do %>
      <div class="flex flex-wrap items-center gap-4">
        <p class="flex-1"><%= @zine.pages.count %> ページ</p>

        <%= link_to "ページ一覧", studio_zine_pages_path(@studio.slug, @zine), class: "btn" %>
      </div>
    <% end %>

    <%= component :card, title: "発行" do %>
      <div class="flex flex-wrap items-center gap-4">
        <% if @zine.published? %>
          <p class="flex-1">
            <%= l @zine.published_at, format: :short %> に発行しました。
          </p>

          <%= button_to "発行取り消し", studio_zine_publication_path(@studio.slug, @zine), method: :delete,
                        disabled: !policy([ :studios, @zine ]).unpublish?,
                        form: { data: { turbo_confirm: "「#{@zine.title}」の発行を取り消します。よろしいですか？" } },
                        class: "btn" %>
        <% else %>
          <div class="flex-1">
            <p class="font-bold">未発行</p>
            <p class="text-base-content/60">すべてのページが確定すると、責任編集者が発行できます。</p>
          </div>

          <%= button_to "発行", studio_zine_publication_path(@studio.slug, @zine),
                        disabled: !policy([ :studios, @zine ]).publish?,
                        form: { data: { turbo_confirm: "「#{@zine.title}」を発行します。よろしいですか？" } },
                        class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>

    <%= component :card, title: "危険な操作", color: :error do %>
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1">
          <p class="font-bold">ZINE を削除</p>
          <p class="text-base-content/60">関連するデータもすべて削除され、元に戻せません。</p>
        </div>

        <%= button_to "削除", studio_zine_path(@studio.slug, @zine), method: :delete,
                      form: { data: { turbo_confirm: "「#{@zine.title}」を削除します。関連するデータもすべて削除されます。よろしいですか？" } },
                      class: "btn btn-outline btn-error" %>
      </div>
    <% end %>
  </div>
<% end %>
