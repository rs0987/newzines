<% content_for :title, @page.title %>

<%= component :page_layout, title: @page.title do |page| %>
  <% page.with_breadcrumb "ZINE 一覧", studio_zines_path(@studio.slug) %>
  <% page.with_breadcrumb @zine.title, studio_zine_path(@studio.slug, @zine) %>
  <% page.with_breadcrumb "ページ一覧", studio_zine_pages_path(@studio.slug, @zine) %>
  <% page.with_breadcrumb @page.title %>

  <div class="flex flex-col gap-6">
    <%= component :card, title: "基本情報" do |card| %>
      <% card.with_action do %>
        <%= link_to "編集", edit_studio_zine_page_path(@studio.slug, @zine, @page), class: "btn btn-sm" %>
      <% end %>

      <%= component :description_list do |list| %>
        <% list.with_item "担当ライター" do %>
          <%= @page.writer.account.username %>
        <% end %>

        <% list.with_item "状態" do %>
          <%= Page.human_attribute_name("status.#{@page.status}") %>
        <% end %>

        <% list.with_item "メモ" do %>
          <p class="whitespace-pre-wrap"><%= @page.note %></p>
        <% end %>
      <% end %>
    <% end %>

    <%= component :card, title: "内容" do |card| %>
      <% card.with_action do %>
        <% if policy([ :studios, @page ]).write? %>
          <%= link_to "編集", edit_studio_zine_page_writing_path(@studio.slug, @zine, @page), class: "btn btn-sm" %>
        <% else %>
          <button type="button" class="btn btn-sm" disabled>編集</button>
        <% end %>
      <% end %>

      <% if @page.draft? && !policy([ :studios, @page ]).confirm? %>
        <% card.with_action do %>
          <%= button_to "提出", submit_studio_zine_page_path(@studio.slug, @zine, @page), method: :patch,
                        disabled: !policy([ :studios, @page ]).submit?,
                        form: { data: { turbo_confirm: "「#{@page.title}」を提出します。提出すると、差し戻されるまで内容を編集できません。よろしいですか？" } },
                        class: "btn btn-sm btn-primary" %>
        <% end %>
      <% end %>

      <% if @page.reviewing? || policy([ :studios, @page ]).confirm? %>
        <% card.with_action do %>
          <%= button_to "確定", confirm_studio_zine_page_path(@studio.slug, @zine, @page), method: :patch,
                        disabled: !policy([ :studios, @page ]).confirm?,
                        form: { data: { turbo_confirm: "「#{@page.title}」を確定します。確定すると、差し戻されるまで内容を編集できません。よろしいですか？" } },
                        class: "btn btn-sm btn-primary" %>
        <% end %>
      <% end %>

      <% if @page.reviewing? || @page.confirmed? %>
        <% card.with_action do %>
          <%= button_to "差し戻す", send_back_studio_zine_page_path(@studio.slug, @zine, @page), method: :patch,
                        disabled: !policy([ :studios, @page ]).send_back?,
                        class: "btn btn-sm" %>
        <% end %>
      <% end %>

      <%# 読者が読むときの見た目で確かめられるように、公開サイトと同じ部品を ZINE のテーマカラーで表示する %>
      <%= tag.div data: { theme: @zine.theme_color }, class: "max-w-2xl overflow-hidden rounded-box border border-base-300 bg-base-100 text-base-content" do %>
        <%= component :zine_page, page: @page, number: @zine.pages.ids.index(@page.id) + 1 %>
      <% end %>
    <% end %>

    <%= component :card, title: "危険な操作", color: :error do %>
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1">
          <p class="font-bold">ページを削除</p>
          <p class="text-base-content/60">本文も削除され、元に戻せません。</p>
        </div>

        <%= button_to "削除", studio_zine_page_path(@studio.slug, @zine, @page), method: :delete,
                      form: { data: { turbo_confirm: "「#{@page.title}」を削除します。本文も削除されます。よろしいですか？" } },
                      class: "btn btn-outline btn-error" %>
      </div>
    <% end %>
  </div>
<% end %>
