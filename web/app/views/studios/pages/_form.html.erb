<%= form_with model: page, url: (page.new_record? ? studio_zine_pages_path(studio.slug, zine) : studio_zine_page_path(studio.slug, zine, page)) do |f| %>
  <%= component :form_layout do |layout| %>
    <%= component :select_field, f, :writer_id,
          studio.writers.includes(:account).map { |writer| [ writer.account.username, writer.id ] }.sort,
          label: "担当ライター", hint: "スタジオのメンバーから選びます。",
          required: true %>

    <% layout.with_action do %>
      <%= f.submit "保存", class: "btn btn-primary btn-wide" %>
    <% end %>
  <% end %>
<% end %>
