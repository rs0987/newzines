<!DOCTYPE html>

<html data-theme="lofi" class="overflow-y-scroll">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | NewZINES" : "NewZINES" %></title>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-base-200">
    <%= render "layouts/flash" %>

    <div
      class="
        drawer mx-auto max-w-7xl bg-base-100 md:drawer-open
        md:grid-cols-[1fr_var(--container-lg)]
        lg:grid-cols-[1fr_var(--container-lg)_1fr]
      "
    >
      <input id="reader-menu" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex min-h-screen flex-col border-base-content md:border-x">
        <div
          class="
            sticky top-0 z-20 flex h-14 items-center gap-2 border-b
            border-base-300 bg-base-100 px-2 md:hidden
          "
        >
          <label
            for="reader-menu"
            aria-label="メニューを開く"
            class="btn btn-square btn-ghost"
          >
            <%= component :hamburger_icon %>
          </label>

          <%= link_to "NewZINES", root_path, class: "text-lg font-bold" %>
        </div>

        <%= tag.main data: { theme: content_for(:theme) }, class: "flex-1 bg-base-100 text-base-content" do %>
          <%= yield %>
        <% end %>
      </div>

      <div class="drawer-side z-40">
        <label for="reader-menu" aria-label="メニューを閉じる" class="drawer-overlay"></label>

        <nav
          aria-label="メニュー"
          class="flex min-h-full w-64 flex-col gap-2 bg-base-100 p-4 md:w-full"
        >
          <%= link_to "NewZINES", root_path, class: "text-2xl font-bold" %>
        </nav>
      </div>

      <% if content_for?(:toc) %>
        <%# もくじがある場合は、ZINE のテーマに合わせる %>
        <%= tag.div data: { theme: content_for(:theme) },
                    class: "sticky top-0 col-start-3 row-start-1 hidden h-screen overflow-y-auto bg-base-100 p-4 lg:block" do %>
          <%= yield :toc %>
        <% end %>
      <% else %>
        <div class="sticky top-0 col-start-3 row-start-1 hidden h-screen flex-col p-4 lg:flex">
          <%= image_tag "books.png", alt: "", class: "mt-auto w-48 self-end p-4" %>
        </div>
      <% end %>
    </div>

    <% if content_for?(:toc) %>
      <%# タブレット幅とスマホ幅では、もくじをメニューとは別のドロワーにして右から開く %>
      <div class="drawer drawer-end lg:hidden">
        <input id="reader-toc" type="checkbox" class="drawer-toggle">
        <div class="drawer-content"></div>

        <div class="drawer-side z-40">
          <label for="reader-toc" aria-label="もくじを閉じる" class="drawer-overlay"></label>

          <%= tag.div id: "reader-toc-panel", data: { theme: content_for(:theme) }, class: "min-h-full w-64 bg-base-100 p-4" do %>
            <%= yield :toc %>
          <% end %>
        </div>
      </div>
    <% end %>
  </body>
</html>
