<% content_for :admin_content do %>
  <div class="drawer md:drawer-open">
    <input id="admin-menu" type="checkbox" class="drawer-toggle">

    <div class="drawer-content min-w-0">
      <div class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b border-base-300 bg-base-100 px-2 md:hidden">
        <label for="admin-menu" aria-label="メニューを開く" class="btn btn-square btn-ghost">
          <%= component :hamburger_icon %>
        </label>
        <%= link_to "NewZINES 管理者サイト", admin_root_path, class: "text-lg font-bold" %>
      </div>

      <div class="px-4 pb-8 md:px-8">
        <%= yield %>
      </div>
    </div>

    <div class="drawer-side z-40">
      <label for="admin-menu" aria-label="メニューを閉じる" class="drawer-overlay"></label>

      <nav
        aria-label="管理メニュー"
        class="flex min-h-full w-64 flex-col gap-2 border-r border-base-300 bg-base-100 py-4"
      >
        <%= link_to "NewZINES 管理者サイト", admin_root_path, class: "btn btn-ghost mx-2 justify-start text-lg" %>

        <ul class="menu w-full flex-1">
          <li>
            <%= link_to "ダッシュボード", admin_root_path, class: ("menu-active" if controller_name == "dashboards") %>
          </li>
          <li>
            <%= link_to "スタジオ", admin_studios_path, class: ("menu-active" if controller_name.in?(%w[studios invitations])) %>
          </li>
        </ul>

        <details class="dropdown dropdown-top border-t border-base-300 px-2 pt-2">
          <summary class="btn btn-ghost w-full justify-start gap-3">
            <div class="avatar avatar-placeholder" aria-hidden="true">
              <div class="w-7 rounded-full bg-neutral text-neutral-content">
                <span class="text-xs"><%= current_administrator.username.first.upcase %></span>
              </div>
            </div>
            <%= current_administrator.username %>
          </summary>

          <ul class="menu dropdown-content z-30 w-full rounded-box bg-base-100 p-2 shadow">
            <li>
              <%# ボタンを横幅いっぱいにするため、daisyUI が form に付ける grid を flex で上書きする %>
              <%= button_to "Log out", destroy_administrator_session_path, method: :delete,
                            form: { class: "flex" },
                            class: "w-full cursor-pointer text-left" %>
            </li>
          </ul>
        </details>
      </nav>
    </div>
  </div>
<% end %>

<%= render template: "layouts/admin" %>
