<% content_for :studio_content do %>
  <div class="drawer md:drawer-open">
    <input id="studio-menu" type="checkbox" class="drawer-toggle">

    <div class="drawer-content min-w-0">
      <div
        class="
          sticky top-0 z-20 flex h-14 items-center gap-2 border-b
          border-base-300 bg-base-100 px-2 md:hidden
        "
      >
        <label
          for="studio-menu"
          aria-label="メニューを開く"
          class="btn btn-square btn-ghost"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            />
          </svg>
        </label>

        <%= link_to @studio.name, studio_root_path(@studio.slug), class: "text-lg font-bold" %>
      </div>

      <div class="px-4 pb-8 md:px-8">
        <%= yield %>
      </div>
    </div>

    <div class="drawer-side z-40">
      <label for="studio-menu" aria-label="メニューを閉じる" class="drawer-overlay"></label>

      <nav
        aria-label="スタジオメニュー"
        class="
          flex min-h-full w-64 flex-col gap-2 border-r border-base-300
          bg-base-100 py-4
        "
      >
        <%= link_to @studio.name, studio_root_path(@studio.slug), class: "btn btn-ghost mx-2 justify-start text-lg" %>

        <ul class="menu w-full flex-1">
          <li>
            <%= link_to "ダッシュボード", studio_root_path(@studio.slug), class: ("menu-active" if controller_name == "dashboards") %>
          </li>

          <li>
            <%= link_to "ZINE", studio_zines_path(@studio.slug), class: ("menu-active" if controller_name.in?(%w[zines pages writings])) %>
          </li>
        </ul>

        <details class="dropdown dropdown-top border-t border-base-300 px-2 pt-2">
          <summary class="btn btn-ghost h-12 w-full justify-start gap-3">
            <div class="avatar avatar-placeholder" aria-hidden="true">
              <div class="w-7 rounded-full bg-neutral text-neutral-content">
                <span class="text-xs"><%= current_account.username.first.upcase %></span>
              </div>
            </div>

            <div class="flex flex-col items-start">
              <span><%= current_account.username %></span>
              <span class="text-xs text-base-content/60"><%= StudioMembership.human_attribute_name("role.#{@studio_membership.role}") %></span>
            </div>
          </summary>

          <ul
            class="
              menu dropdown-content z-30 w-full rounded-box bg-base-100 p-2
              shadow
            "
          >
            <li>
              <%# ボタンを横幅いっぱいにするため、daisyUI が form に付ける grid を flex で上書きする %>
              <%= button_to "ログアウト", destroy_account_session_path, method: :delete,
                            form: { class: "flex" },
                            class: "w-full cursor-pointer text-left" %>
            </li>
          </ul>
        </details>
      </nav>
    </div>
  </div>
<% end %>

<%= render template: "layouts/studio" %>
