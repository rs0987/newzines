<!DOCTYPE html>

<html data-theme="corporate">
  <head>
    <title><%= content_for(:title) || "管理者サイト" %> | NewZINES</title>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen bg-base-200">
    <header class="navbar bg-base-100 shadow-sm">
      <div class="flex-1">
        <span class="text-lg font-bold">NewZINES 管理者サイト</span>
      </div>

      <% if administrator_signed_in? %>
        <div class="flex items-center gap-4">
          <span class="text-sm"><%= current_administrator.username %></span>
          <%= button_to "Log out", destroy_administrator_session_path, method: :delete, class: "btn btn-sm btn-ghost" %>
        </div>
      <% end %>
    </header>

    <main class="container mx-auto px-4 py-8">
      <% flash.each do |type, message| %>
        <div role="alert" class="alert <%= type == "alert" ? "alert-error" : "alert-success" %> mb-6">
          <span><%= message %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
