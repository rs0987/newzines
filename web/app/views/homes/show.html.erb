<%= component :public_page_layout, title: "ホーム" do %>
  <section class="flex flex-col gap-4 px-4">
    <h2 class="text-lg font-bold">最近発行された ZINE</h2>

    <% if @zines.any? %>
      <ul class="flex flex-col gap-4">
        <% @zines.each do |zine| %>
          <li><%= component :zine_card, zine: %></li>
        <% end %>
      </ul>
    <% else %>
      <p>まだ発行された ZINE はありません。</p>
    <% end %>
  </section>
<% end %>
