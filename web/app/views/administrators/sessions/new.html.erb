<% content_for :title, "ログイン" %>

<div class="card mx-auto w-full max-w-sm bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title text-2xl">管理者サイトにログイン</h1>

    <%= form_with model: resource, scope: :administrator, url: administrator_session_path do |f| %>
      <%= component :text_field, f, :username, autofocus: true, autocomplete: "username" %>

      <%= component :password_field, f, :password, autocomplete: "current-password" %>

      <%= f.submit "ログイン", class: "btn btn-primary w-full mt-4" %>
    <% end %>
  </div>
</div>

