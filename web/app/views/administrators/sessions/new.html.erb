<% content_for :title, "Log in" %>

<div class="card mx-auto w-full max-w-sm bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title text-2xl">Log in</h1>

    <%= form_with model: resource, scope: :administrator, url: administrator_session_path do |f| %>
      <fieldset class="fieldset">
        <%= f.label :username, class: "label" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "input w-full" %>

        <%= f.label :password, class: "label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input w-full" %>

        <%= f.submit "Log in", class: "btn btn-primary mt-4" %>
      </fieldset>
    <% end %>
  </div>
</div>
