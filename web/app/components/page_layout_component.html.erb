<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= @title %></h1>

    <% if actions? %>
      <div class="flex items-center gap-2">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div>
    <%= content %>
  </div>
</div>
