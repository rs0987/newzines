<% if back? || actions? %>
  <%# スマホでは、レイアウトの上の帯（h-14）の真下に固定する %>
  <div
    class="
      sticky top-14 z-10 flex h-12 items-center border-b border-base-300
      bg-base-100 px-2 md:top-0
    "
  >
    <%= back %>

    <% if actions? %>
      <div class="ml-auto flex items-center gap-2">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="flex flex-col gap-4 pb-4">
  <h1 class="bg-primary px-4 py-2 text-xl font-bold text-primary-content"><%= @title %></h1>

  <% if description? %>
    <p class="px-4"><%= description %></p>
  <% end %>

  <div>
    <%= content %>
  </div>
</div>
