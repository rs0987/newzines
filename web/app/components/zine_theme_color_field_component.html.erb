<%= component :fieldset, @form, :theme_color, hint: @hint do %>
  <div class="flex flex-wrap gap-3">
    <% Zine.theme_colors.each_key do |theme_color| %>
      <label
        class="
          flex cursor-pointer flex-col gap-1 rounded-box p-1
          has-checked:ring-2 has-checked:ring-primary
          has-focus-visible:outline-2 has-focus-visible:outline-offset-2
        "
      >
        <%= @form.radio_button :theme_color, theme_color, class: "sr-only" %>
        <%= component :zine_theme_color_sample, theme_color: %>
      </label>
    <% end %>
  </div>
<% end %>
