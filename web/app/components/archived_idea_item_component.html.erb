<div id="<%= dom_id(@idea) %>" class="grid grid-cols-[1fr_2fr_auto] divide-x divide-base-300">
  <dt class="min-h-10 px-3 py-2"><%= @idea.title %></dt>
  <dd class="min-h-10 px-3 py-2"><%= @idea.body %></dd>

  <dd class="flex items-center gap-1 px-1">
    <%= button_to studio_idea_archive_path(@idea.studio.slug, @idea), method: :delete,
                  aria: { label: "一覧に戻す" },
                  class: "btn btn-square btn-ghost btn-xs" do %>
      <%= component :arrow_uturn_left_icon %>
    <% end %>

    <%= button_to studio_archived_idea_path(@idea.studio.slug, @idea), method: :delete,
                  aria: { label: "削除" },
                  form: { data: { turbo_confirm: confirm_message } },
                  class: "btn btn-square btn-ghost btn-xs text-error" do %>
      <%= component :trash_icon %>
    <% end %>
  </dd>
</div>
